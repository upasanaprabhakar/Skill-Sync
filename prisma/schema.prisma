generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  MENTOR
  BOTH
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum NoteTag {
  GOAL
  RESOURCE
  PROGRESS
  HOMEWORK
  GENERAL
}

enum SessionStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  MISSED
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  name            String?
  password        String
  bio             String?
  role            UserRole  @default(STUDENT)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  skillsKnown     Skill[]   @relation("UserKnownSkills")
  skillsLearning  Skill[]   @relation("UserLearningSkills")
  
  mentorConnections   Connection[] @relation("MentorConnections")
  studentConnections  Connection[] @relation("StudentConnections")
  
  mentorSkillGroups   SkillGroup[] @relation("MentorSkillGroups")

  sentMessages        Message[]    @relation("SentMessages")
  receivedMessages    Message[]    @relation("ReceivedMessages")
  
  notes               Note[]       @relation("UserNotes")
  
  reviewsGiven        Review[]     @relation("StudentReviews")
  reviewsReceived     Review[]     @relation("MentorReviews")

  @@map("users")
}

model Skill {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  category    String?
  createdAt   DateTime  @default(now())
  
  knownBy     User[]    @relation("UserKnownSkills")
  learningBy  User[]    @relation("UserLearningSkills")
  
  skillGroups SkillGroup[]
  
  @@map("skills")
}

model SkillGroup {
  id          Int       @id @default(autoincrement())
  mentorId    Int
  skillId     Int
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  mentor      User      @relation("MentorSkillGroups", fields: [mentorId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)
  
  connections Connection[]
  notes       Note[]
  
  @@unique([mentorId, skillId])
  @@map("skill_groups")
}

model Connection {
  id            Int              @id @default(autoincrement())
  mentorId      Int
  studentId     Int
  skillGroupId  Int?
  status        ConnectionStatus @default(PENDING)
  message       String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  
  mentor        User             @relation("MentorConnections", fields: [mentorId], references: [id], onDelete: Cascade)
  student       User             @relation("StudentConnections", fields: [studentId], references: [id], onDelete: Cascade)
  skillGroup    SkillGroup?      @relation(fields: [skillGroupId], references: [id], onDelete: SetNull)

  messages      Message[]
  review        Review?
  sessions      Session[]

  @@unique([mentorId, studentId])
  @@map("connections")
}

model Message {
  id           Int        @id @default(autoincrement())
  senderId     Int
  receiverId   Int
  connectionId Int
  content      String     @db.Text
  read         Boolean    @default(false)
  createdAt    DateTime   @default(now())
  
  sender       User       @relation("SentMessages", fields: [senderId], references: [id])
  receiver     User       @relation("ReceivedMessages", fields: [receiverId], references: [id])
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  
  @@index([connectionId])
  @@index([senderId, receiverId])
  @@map("messages")
}

model Note {
  id           Int        @id @default(autoincrement())
  skillGroupId Int
  title        String
  content      String     @db.Text
  createdBy    Int
  tags         NoteTag[]
  isPinned     Boolean    @default(false)
  fileUrl      String?
  fileName     String?
  fileType     String?
  isCompleted  Boolean    @default(false)  
  completedAt  DateTime?                   
  completedBy  Int?                        
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  skillGroup   SkillGroup @relation(fields: [skillGroupId], references: [id], onDelete: Cascade)
  creator      User       @relation("UserNotes", fields: [createdBy], references: [id])
  
  @@index([skillGroupId])
  @@index([createdBy])
  @@index([isCompleted])  
  @@map("notes")
}

model Review {
  id           Int        @id @default(autoincrement())
  rating       Int
  comment      String?    @db.Text
  connectionId Int        @unique
  studentId    Int
  mentorId     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  student      User       @relation("StudentReviews", fields: [studentId], references: [id], onDelete: Cascade)
  mentor       User       @relation("MentorReviews", fields: [mentorId], references: [id], onDelete: Cascade)
  
  @@index([mentorId])
  @@index([studentId])
  @@map("reviews")
}

model Session {
  id              Int           @id @default(autoincrement())
  connectionId    Int
  title           String
  description     String?       @db.Text
  startTime       DateTime
  endTime         DateTime
  duration        Int
  meetingLink     String?
  status          SessionStatus @default(PENDING)
  notes           String?       @db.Text
  joinedByMentor  Boolean       @default(false)
  joinedByStudent Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  connection      Connection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  reminders       Reminder[]
  
  @@index([connectionId])
  @@index([startTime])
  @@index([status])
  @@map("sessions")
}

model Reminder {
  id            Int       @id @default(autoincrement())
  sessionId     Int
  reminderType  String
  sentAt        DateTime?
  scheduledFor  DateTime
  sent          Boolean   @default(false)
  createdAt     DateTime  @default(now())
  
  session       Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  
  @@index([sessionId])
  @@index([scheduledFor, sent])
  @@map("reminders")
}